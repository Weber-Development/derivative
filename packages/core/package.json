{
  "name": "@sweberdev/derivative",
  "version": "0.0.0",
  "description": "Self-hosted changelog and \"What's new\" widget. Generates changelog.json, an Atom feed and a page from Changesets, CHANGELOG.md or conventional commits. No SaaS, no tracking.",
  "license": "MIT",
  "author": "Seya Weber (https://github.com/sxwxbxr)",
  "homepage": "https://packages.sweber.dev/derivative/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weber-Development/derivative.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Weber-Development/derivative/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/widget-auto.js",
    "./dist/widget-auto.cjs",
    "./src/widget-auto.ts"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./widget": {
      "import": {
        "types": "./dist/widget-auto.d.ts",
        "default": "./dist/widget-auto.js"
      },
      "require": {
        "types": "./dist/widget-auto.d.cts",
        "default": "./dist/widget-auto.cjs"
      }
    },
    "./widget/define": {
      "import": {
        "types": "./dist/widget.d.ts",
        "default": "./dist/widget.js"
      },
      "require": {
        "types": "./dist/widget.d.cts",
        "default": "./dist/widget.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "derivative": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "changelog",
    "whats-new",
    "release-notes",
    "changesets",
    "conventional-commits",
    "web-component",
    "widget",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^27.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
